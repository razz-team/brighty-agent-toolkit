{
  "name": "brighty-agent-toolkit",
  "version": "0.0.1",
  "private": true,
  "description": "Brighty banking and payments for AI agents: MCP server (stdio) + AgentSkills + Anthropic plugin manifest. Works with Claude Code, Claude Desktop, Codex, Cursor, OpenClaw, and any MCP/AgentSkills-compatible client.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/razz-team/brighty-agent-toolkit.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "validate": "npx -y skills-ref validate skills/brighty-banking && npx -y skills-ref validate skills/brighty-payouts && npx -y skills-ref validate skills/brighty-invoice-pay && npx -y skills-ref validate skills/brighty-cards",
    "validate-plugin": "node scripts/validate-plugin.mjs",
    "check-tools": "node scripts/check-tool-references.mjs",
    "build": "yarn workspaces foreach --all --topological --verbose run build",
    "test": "yarn workspaces foreach --all --verbose run test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "dev:server": "yarn workspace @brighty-app/mcp-server dev",
    "login": "yarn workspace @brighty-app/mcp-server exec brighty-mcp-login",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-versions.mjs",
    "release": "yarn workspace @brighty-app/mcp-server build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@4.14.1+sha512.64df448055b2d37ba269d7db535a469b8da93f8ef1140c25fd7a83c00a8fbaacb214ca0e02553b92a2c54cef78bb67d0b4817fab02001df0e24fac0faccc3b42"
}
